{
  "openapi": "3.1.0",
  "info": {
    "title": "aooscope-server",
    "description": "",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.3.0-dev"
  },
  "paths": {
    "/api/display/capabilities": {
      "get": {
        "tags": [
          "routes::display"
        ],
        "operationId": "get_capabilities",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisplayCapabilitiesDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/display/luminance": {
      "post": {
        "tags": [
          "routes::display"
        ],
        "operationId": "set_luminance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisplayLuminanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/display/power": {
      "post": {
        "tags": [
          "routes::display"
        ],
        "operationId": "set_power",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisplayPowerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisplayPowerDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "routes::health"
        ],
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "routes::catalog"
        ],
        "operationId": "get_metrics",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricCatalogDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages": {
      "get": {
        "tags": [
          "routes::pages"
        ],
        "operationId": "get_pages",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagesListDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/catalog": {
      "get": {
        "tags": [
          "routes::catalog"
        ],
        "operationId": "get_provider_catalog",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCatalogDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "routes::settings"
        ],
        "operationId": "get_settings",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSettingsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "routes::status"
        ],
        "operationId": "get_status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DisplayCapabilitiesDto": {
        "type": "object",
        "required": [
          "width",
          "height",
          "native_brightness",
          "power_control",
          "power_on"
        ],
        "properties": {
          "height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "native_brightness": {
            "type": "boolean"
          },
          "power_control": {
            "type": "boolean"
          },
          "power_on": {
            "type": "boolean"
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "DisplayLuminanceRequest": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "DisplayPowerDto": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      },
      "DisplayPowerRequest": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      },
      "DisplaySettings": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "brightness": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "schedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleRule"
            }
          },
          "schedule_enabled": {
            "type": "boolean"
          },
          "switch_seconds": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "HealthDto": {
        "type": "object",
        "required": [
          "ok",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "MetricCatalogDto": {
        "type": "object",
        "required": [
          "metrics"
        ],
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricDescriptor"
            }
          }
        }
      },
      "MetricDescriptor": {
        "type": "object",
        "required": [
          "id",
          "label",
          "provider_id",
          "provider_name",
          "category",
          "value_type",
          "unit",
          "online",
          "recommended_widgets"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "demo_value": {},
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "max": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "min": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "online": {
            "type": "boolean"
          },
          "provider_id": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "recommended_widgets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WidgetKind"
            }
          },
          "unit": {
            "type": "string"
          },
          "value": {},
          "value_type": {
            "type": "string"
          }
        }
      },
      "PageSummaryDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "enabled",
          "duration",
          "revision"
        ],
        "properties": {
          "duration": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PagesListDto": {
        "type": "object",
        "required": [
          "schema_version",
          "revision",
          "carousel",
          "pages"
        ],
        "properties": {
          "carousel": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageSummaryDto"
            }
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ProviderCatalogDto": {
        "type": "object",
        "required": [
          "providers"
        ],
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderDescriptor"
            }
          }
        }
      },
      "ProviderDescriptor": {
        "type": "object",
        "required": [
          "id",
          "name",
          "icon",
          "categories",
          "credential_fields"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "credential_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "icon": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PublicProviderDto": {
        "type": "object",
        "required": [
          "enabled",
          "url",
          "verify_tls",
          "secret_set"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "node": {
            "type": [
              "string",
              "null"
            ]
          },
          "secret_set": {
            "type": "boolean"
          },
          "system": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "verify_tls": {
            "type": "boolean"
          }
        },
        "additionalProperties": {}
      },
      "PublicSettingsDto": {
        "type": "object",
        "required": [
          "display",
          "providers"
        ],
        "properties": {
          "display": {
            "$ref": "#/components/schemas/DisplaySettings"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/PublicProviderDto"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": {}
      },
      "ScheduleRule": {
        "type": "object",
        "required": [
          "start",
          "end",
          "brightness"
        ],
        "properties": {
          "brightness": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "end": {
            "type": "string"
          },
          "start": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "StatusDto": {
        "type": "object",
        "required": [
          "version",
          "brightness",
          "native_brightness",
          "device_present"
        ],
        "properties": {
          "brightness": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "device_present": {
            "type": "boolean"
          },
          "native_brightness": {
            "type": "boolean"
          },
          "updated_unix": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "WidgetKind": {
        "type": "string",
        "enum": [
          "text",
          "value",
          "bar",
          "gauge",
          "ring",
          "badge",
          "sparkline",
          "image",
          "animation"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "aooscope",
      "description": "AooScope compatibility API"
    }
  ]
}
