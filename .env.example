# AooScope generic example. Copy to .env and adapt to your environment.
AOOSCOPE_IMAGE=aooscope:local
AOOSCOPE_BIND_ADDRESS=127.0.0.1
AOOSCOPE_WEB_PORT=8765
AOOSCOPE_DEVICE=/dev/ttyACM0
AOOSCOPE_CONFIG_DIR=./data/cfg
AOOSCOPE_SECRETS_DIR=./data/secrets
AOOSCOPE_REFRESH_SECONDS=5

# Optional Proxmox provider
PVE_API_URL=https://proxmox.example.invalid:8006/api2/json
PVE_NODE=pve
PVE_TOKEN_FILE=/run/aooscope-secrets/proxmox-token.json
PVE_CA_FILE=/run/aooscope-secrets/proxmox-ca.pem

# Optional media providers
JELLYFIN_URL=http://jellyfin.example.invalid:8096
JELLYFIN_API_KEY_FILE=/run/aooscope-secrets/jellyfin-api-key
SILO_URL=http://silo.example.invalid:8080
SILO_API_KEY_FILE=/run/aooscope-secrets/silo-api-key
RADARR_URL=http://radarr.example.invalid:7878
RADARR_API_KEY_FILE=/run/aooscope-secrets/radarr-api-key
QBIT_URL=http://qbittorrent.example.invalid:8080
